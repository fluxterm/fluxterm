{
  "name": "fluxterm",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "version:set": "node scripts/set-version.mjs",
    "dev": "vite",
    "dev:telemetry": "tauri dev --features performance-telemetry --config src-tauri/tauri.telemetry.conf.json",
    "build": "tauri build",
    "build:fast": "tauri build -- --profile fast-release",
    "build:telemetry": "tauri build --features performance-telemetry --config src-tauri/tauri.telemetry.conf.json",
    "build:fast:telemetry": "tauri build --features performance-telemetry --config src-tauri/tauri.telemetry.conf.json -- --profile fast-release",
    "web:dev": "vite",
    "web:dev:telemetry": "vite --mode telemetry",
    "web:build": "vite build",
    "web:build:telemetry": "vite build --mode telemetry",
    "tauri": "tauri",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "preview": "vite preview",
    "prune": "ts-prune",
    "format": "prettier --write src/",
    "format:all": "pnpm format && cargo fmt",
    "logging:check": "node scripts/check-logging.mjs",
    "logging:test": "node --experimental-strip-types --test src/shared/logging/*.test.ts",
    "connection-validation:test": "node --experimental-strip-types --test src/features/session/core/connectionValidation.test.ts",
    "sftp-transfer-state:test": "node --experimental-strip-types --test src/features/sftp/core/transferState.test.ts",
    "performance-telemetry:check": "node scripts/check-performance-telemetry.mjs",
    "performance-telemetry:test": "node --experimental-strip-types --test src/subapps/rdp/performanceTelemetryCore.test.ts",
    "runtime-message:check": "node scripts/check-runtime-messages.mjs",
    "check": "pnpm type-check && pnpm lint && pnpm logging:check && pnpm logging:test && pnpm connection-validation:test && pnpm sftp-transfer-state:test && pnpm performance-telemetry:check && pnpm performance-telemetry:test && pnpm runtime-message:check",
    "check:all": "pnpm check && cargo clippy --all-targets --all-features -- -D warnings",
    "code:stats": "node --experimental-strip-types scripts/count-code-lines.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "25.0.7",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "3.7.4",
    "ts-prune": "0.10.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "8.0.9"
  },
  "packageManager": "pnpm@10.28.0"
}
